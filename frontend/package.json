{
  "name": "vitube-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "gen:api": "uv run --directory ../backend python -m scripts.export_openapi ../frontend/src/api/openapi.json && npm run gen:types",
    "gen:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.107.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "swagger-ui-dist": "5.34.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "scarfSettings": {
    "enabled": false
  }
}
