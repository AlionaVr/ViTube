  "components": {
    "schemas": {
      "AccessGrant": {
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{3,30}$",
            "title": "Handle",
            "description": "Who may watch, without the @"
          }
        },
        "type": "object",
        "required": [
          "handle"
        ],
        "title": "AccessGrant"
      },
      "ChannelSummary": {
        "properties": {
          "handle": {
            "type": "string",
            "title": "Handle"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          }
        },
        "type": "object",
        "required": [
          "handle",
          "name",
          "avatar_url"
        ],
        "title": "ChannelSummary",
        "description": "What a video card or a comment shows about a user's channel."
      },
      "CommentIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
            "title": "Text"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id",
            "description": "The comment to reply to. A reply to a reply joins its thread."
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CommentIn"
      },
      "CommentOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "author": {
            "$ref": "#/components/schemas/ChannelSummary"
          },
          "by_owner": {
            "type": "boolean",
            "title": "By Owner",
            "description": "Written by the video's owner"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "title": "Published At"
          },
          "like_count": {
            "type": "integer",
            "title": "Like Count"
          },
          "my_rating": {
            "$ref": "#/components/schemas/Rating"
          },
          "reply_count": {
            "type": "integer",
            "title": "Reply Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "author",
          "by_owner",
          "text",
          "published_at",
          "like_count",
          "my_rating",
          "reply_count"
        ],
        "title": "CommentOut"
      },
      "CommentSort": {
        "type": "string",
        "enum": [
          "top",
          "new"
        ],
        "title": "CommentSort"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "description": "Sign in. No length rule here: it applies to new passwords only."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewAccount": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "NewAccount"
      },
      "Page_CommentOut_": {
        "properties": {
          "items": {
            "items": {
