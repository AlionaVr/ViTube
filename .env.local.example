# Template for .env.local: settings for the backend run outside Docker (IDE or `uv run --env-file ../.env.local`).
# Copy to .env.local and put in the passwords from .env. Needs compose.local.yaml (DB ports on localhost).

# vitube_app with POSTGRES_APP_PASSWORD; migrations run in the migrate job, not here.
DATABASE_URL=postgresql+asyncpg://vitube_app:change-me@localhost:5432/vitube
REDIS_URL=redis://:change-me@localhost:6379/0
# 32+ random chars, e.g. from `openssl rand -hex 32`
SESSION_SECRET=change-me
