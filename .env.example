# Template for .env. install.sh copies it and replaces every "change-me" with a random hex secret.
# Keep secrets URL-safe: they are put into connection URLs as is.

# Host port for the site
HTTP_PORT=80

# Superuser: only the migrate job uses it
POSTGRES_USER=vitube
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vitube
# vitube_app: the role api and worker use (data only, ADR 0010)
POSTGRES_APP_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Key for session id HMACs in Redis; 32+ chars
SESSION_SECRET=change-me
# true when the site is served over HTTPS: cookies are then sent over HTTPS only
COOKIE_SECURE=false

# MinIO needs passwords of 8+ chars
MINIO_ROOT_USER=vitube
MINIO_ROOT_PASSWORD=change-me
# User "vitube-app" of api and worker: objects in the bucket only
MINIO_APP_PASSWORD=change-me
S3_BUCKET=vitube

# Upload limits (README). Optional: these are the defaults.
MAX_UPLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SEC=1800
