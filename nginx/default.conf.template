# Template: the nginx image fills in ${MAX_UPLOAD_SIZE_MB} from env at start (NGINX_ENVSUBST_FILTER in compose.yaml).

# Docker DNS: re-resolve "api" at runtime, so an api restart with a new IP doesn't break proxying.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api {
    zone api 64k;
    server api:8000 resolve;
}

server {
    listen 8080;  # unprivileged image: no root to bind 80; compose maps 80 -> 8080
    server_tokens off;
    root /usr/share/nginx/html;

    # Basic hardening. CSP comes with the security stage.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Keeps the port: the API compares Host with Origin (CSRF check).
    proxy_set_header Host $http_host;
    # nginx is the edge proxy: overwrite, because uvicorn trusts the leftmost address.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/ {
        proxy_pass http://api;
    }

    # Video file upload (ADR 0006): passed on to the API as it arrives, never buffered here.
    location ~ ^/api/videos/[^/]+/file$ {
        client_max_body_size ${MAX_UPLOAD_SIZE_MB}m;
        proxy_request_buffering off;
        proxy_http_version 1.1;  # streams a chunked body too
        proxy_pass http://api;
    }

    location = /docs {
        proxy_pass http://api;
    }

    # File names have content hashes, so they can be cached forever.
    location /assets/ {
        expires 1y;
    }

    # Always revalidate, so a new deploy is picked up at once.
    location = /index.html {
        expires -1;
    }

    # SPA: unknown paths get index.html, React Router handles them.
    location / {
        try_files $uri /index.html;
    }
}
